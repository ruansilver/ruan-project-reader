+            continue
+        heading = re.fullmatch(r" {0,3}(#{1,6})(?:[ \t]+(.*)|[ \t]*)", line)
+        if heading:
+            title = re.sub(r"(?:^|[ \t]+)#+[ \t]*$", "", heading[2] or "").strip()
+            headings.append((i, len(heading[1]), title))
+    if opened:
+        raise ContractError("未验证", f"第 {opened[0]+1} 行代码围栏未闭合")
+    return lines, headings, blocks
